{
  "name": "@sytechui/sidebar",
  "version": "2.0.0",
  "description": "A composable responsive sidebar for application layouts.",
  "keywords": [
    "sidebar",
    "navigation",
    "layout"
  ],
  "author": "HeroUI <support@heroui.com>",
  "homepage": "https://heroui.com",
  "license": "MIT",
  "main": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heroui-inc/heroui.git",
    "directory": "packages/components/sidebar"
  },
  "bugs": {
    "url": "https://github.com/heroui-inc/heroui/issues"
  },
  "scripts": {
    "build": "tsup src --dts",
    "build:fast": "tsup src",
    "dev": "pnpm build:fast --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": ">=18 || >=19.0.0-rc.0",
    "react-dom": ">=18 || >=19.0.0-rc.0",
    "@sytechui/system": ">=2.4.23",
    "@sytechui/theme": ">=2.4.24"
  },
  "dependencies": {
    "@sytechui/button": "workspace:*",
    "@sytechui/divider": "workspace:*",
    "@sytechui/drawer": "workspace:*",
    "@sytechui/input": "workspace:*",
    "@sytechui/link": "workspace:*",
    "@sytechui/shared-icons": "workspace:*",
    "@sytechui/tooltip": "workspace:*",
    "@sytechui/use-media-query": "workspace:*"
  },
  "devDependencies": {
    "@storybook/test": "8.6.18",
    "clean-package": "2.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0"
  },
  "clean-package": "../../../clean-package.config.json"
}
