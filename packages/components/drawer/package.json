{
  "name": "@sytechui/drawer",
  "version": "2.3.1",
  "description": "Used to render a content that slides in from the side of the screen.",
  "keywords": [
    "drawer"
  ],
  "author": "HeroUI <support@heroui.com>",
  "homepage": "https://heroui.com",
  "license": "MIT",
  "main": "dist/index.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heroui-inc/heroui.git",
    "directory": "packages/components/drawer"
  },
  "bugs": {
    "url": "https://github.com/heroui-inc/heroui/issues"
  },
  "scripts": {
    "build": "tsup src --dts",
    "build:fast": "tsup src",
    "dev": "pnpm build:fast --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": ">=18 || >=19.0.0-rc.0",
    "react-dom": ">=18 || >=19.0.0-rc.0",
    "@sytechui/theme": ">=2.4.27",
    "@sytechui/system": ">=2.4.18"
  },
  "dependencies": {
    "@sytechui/shared-utils": "workspace:*",
    "@sytechui/react-utils": "workspace:*",
    "@sytechui/framer-utils": "workspace:*",
    "@sytechui/modal": "workspace:*"
  },
  "clean-package": "../../../clean-package.config.json",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
