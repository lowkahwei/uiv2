{
  "name": "@heroui/drop-zone",
  "version": "2.0.0",
  "description": "A HeroUI styled drop zone component built on top of React Aria drag and drop.",
  "keywords": [
    "drop-zone",
    "dropzone",
    "drag-and-drop",
    "upload"
  ],
  "author": "HeroUI <support@heroui.com>",
  "homepage": "https://heroui.com",
  "license": "MIT",
  "main": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heroui-inc/heroui.git",
    "directory": "packages/components/drop-zone"
  },
  "bugs": {
    "url": "https://github.com/heroui-inc/heroui/issues"
  },
  "scripts": {
    "build": "tsup src --dts",
    "build:fast": "tsup src",
    "dev": "pnpm build:fast --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": ">=18 || >=19.0.0-rc.0",
    "react-dom": ">=18 || >=19.0.0-rc.0",
    "framer-motion": ">=11.5.6 || >=12.0.0-alpha.1",
    "@heroui/theme": ">=2.4.24",
    "@heroui/system": ">=2.4.18"
  },
  "dependencies": {
    "@heroui/react-utils": "workspace:*",
    "@heroui/shared-utils": "workspace:*",
    "@heroui/use-aria-button": "workspace:*",
    "@react-aria/dnd": "3.11.6",
    "@react-aria/focus": "3.21.5",
    "@react-aria/interactions": "3.27.1",
    "@react-stately/utils": "3.11.0",
    "@react-types/shared": "3.33.1",
    "attr-accept": "2.2.5"
  },
  "devDependencies": {
    "@heroui/theme": "workspace:*",
    "@heroui/system": "workspace:*",
    "clean-package": "2.2.0",
    "framer-motion": "11.18.2",
    "react": "18.3.0",
    "react-dom": "18.3.0"
  },
  "clean-package": "../../../clean-package.config.json"
}
