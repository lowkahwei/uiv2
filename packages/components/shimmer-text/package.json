    "@sytechui/system": ">=2.4.18"
  },
  "devDependencies": {
    "@sytechui/theme": "workspace:*",
    "@sytechui/system": "workspace:*",
    "@sytechui/test-utils": "workspace:*",
    "clean-package": "2.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0"
  },
  "clean-package": "../../../clean-package.config.json"
}
